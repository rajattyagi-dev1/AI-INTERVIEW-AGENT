# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# LLM provider: openai | groq | anthropic | mock
LLM_PROVIDER=openai

# Model name for the chosen provider
# OpenAI examples:    gpt-4o-mini  |  gpt-4o
# Groq examples:      llama-3.3-70b-versatile  |  llama-3.1-8b-instant
# Anthropic examples: claude-3-5-sonnet-20241022  |  claude-3-5-haiku-20241022
# Mock (tests):       mock-model  (no API key needed)
LLM_MODEL=gpt-4o-mini

# API key for the chosen provider
# OpenAI:    https://platform.openai.com/api-keys
# Groq:      https://console.groq.com/keys
# Anthropic: https://console.anthropic.com/settings/keys
# Mock:      leave empty — no key required
LLM_API_KEY=your-api-key-here
